#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
SECONDS=0

echo 'Installing missing PHP 8.5 system packages'
packages=(php8.5-cli php8.5-curl php8.5-mbstring php8.5-xml php8.5-sqlite3 php8.5-gd php8.5-zip unzip)
missing=()
for package in "${packages[@]}"; do
    if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
        missing+=("$package")
    fi
done
if ((${#missing[@]})); then
    if [[ ! -f /usr/share/keyrings/debsuryorg-archive-keyring.gpg ]]; then
        keyring=$(mktemp --suffix=.deb)
        curl -fsSL https://packages.sury.org/debsuryorg-archive-keyring.deb -o "$keyring"
        sudo dpkg -i "$keyring"
        rm -f "$keyring"
    fi
    . /etc/os-release
    echo "deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ $VERSION_CODENAME main" | sudo tee /etc/apt/sources.list.d/php.list >/dev/null
    sudo apt-get update -qq
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi
sudo update-alternatives --set php /usr/bin/php8.5
echo "System packages ready (${SECONDS}s elapsed)"

if ! command -v composer >/dev/null; then
    installer=$(mktemp)
    curl -fsSL https://getcomposer.org/installer -o "$installer"
    expected=$(curl -fsSL https://composer.github.io/installer.sig)
    actual=$(sha384sum "$installer" | cut -d ' ' -f 1)
    [[ "$actual" == "$expected" ]] || { rm -f "$installer"; echo 'Composer installer checksum mismatch' >&2; exit 1; }
    php "$installer" --2 --install-dir=/tmp --filename=orb-composer
    sudo install -m 755 /tmp/orb-composer /usr/local/bin/composer
    rm -f "$installer" /tmp/orb-composer
fi

# Node and Bun are provided by the orb base image; keep the repository's Bun lockfile.
node --version
bun --version
[[ -f .env ]] || cp -- .env.example .env
mkdir -p storage/framework/{cache/data,sessions,views} storage/logs bootstrap/cache
echo 'Installing locked PHP dependencies'
time composer install --no-interaction --prefer-dist --no-progress
echo 'Installing locked frontend dependencies'
time bun install --frozen-lockfile

echo 'Preparing local Laravel state'
# Do not replace an existing application key or database.
if grep -q '^APP_KEY=$' .env; then
    php artisan key:generate --no-interaction
fi
[[ -f database/database.sqlite ]] || touch database/database.sqlite
php artisan migrate --database=sqlite --force --no-interaction
if [[ ! -e public/storage && ! -L public/storage ]]; then
    php artisan storage:link --no-interaction
fi
echo 'Building frontend assets for the PHP preview server'
time bun run build
echo "Orb setup finished in ${SECONDS}s"
